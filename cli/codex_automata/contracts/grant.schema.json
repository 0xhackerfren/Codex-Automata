{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-automata:1.0:grant",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "enum": [
        "DEVELOP",
        "OPERATE",
        "MAINTAIN_METHODOLOGY"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_version": {
      "const": "1.0"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "actor",
    "task_id",
    "repository",
    "context",
    "capabilities",
    "write_paths",
    "policy_version",
    "supersedes",
    "reason"
  ],
  "additionalProperties": false
}
