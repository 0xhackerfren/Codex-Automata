{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-automata:1.0:benchmark",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "arm": {
      "enum": [
        "bare",
        "concise",
        "automata"
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "budget_bytes": {
      "type": "integer",
      "minimum": 1024
    },
    "attempts": {
      "type": "integer",
      "minimum": 1
    },
    "tokens_consumed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "agent_wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "human_interventions": {
      "type": "integer",
      "minimum": 0
    },
    "measurement_source": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "arm",
    "model_id",
    "model_version",
    "budget_bytes",
    "attempts",
    "tokens_consumed",
    "agent_wall_seconds",
    "human_interventions",
    "measurement_source"
  ],
  "additionalProperties": false
}
