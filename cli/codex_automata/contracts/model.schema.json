{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-automata:1.0:model",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "enum": [
        "local",
        "external"
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "available": {
      "type": "boolean"
    },
    "data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context_limit_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "structured_output_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "tool_call_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "coding_acceptance_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "regression_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "failure_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "security_eligible": {
      "type": "boolean"
    },
    "security_sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "throughput_tokens_per_second": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "resources": {
      "type": "object",
      "properties": {
        "ram_gb": {
          "type": "number",
          "minimum": 0
        },
        "accelerator": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ram_gb",
        "accelerator"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "source",
        "evidence_sha256",
        "measured_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "provider",
    "execution",
    "approved",
    "available",
    "data_classes",
    "phases",
    "context_limit_bytes",
    "structured_output_rate",
    "tool_call_rate",
    "coding_acceptance_rate",
    "regression_rate",
    "failure_rate",
    "sample_count",
    "security_eligible",
    "security_sample_count",
    "throughput_tokens_per_second",
    "resources",
    "measurement"
  ],
  "additionalProperties": false
}
