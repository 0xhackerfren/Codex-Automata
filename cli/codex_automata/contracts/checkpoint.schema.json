{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-automata:1.0:checkpoint",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "methodology_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact": {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": 1
              },
              "methodology_version": {
                "const": "1.0"
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "packet_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "phase": {
                "enum": [
                  "intake",
                  "architect",
                  "specify",
                  "sdk",
                  "mold",
                  "cast",
                  "review",
                  "product",
                  "observe"
                ]
              },
              "head_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "blob": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  },
                  "required": [
                    "path",
                    "blob"
                  ],
                  "additionalProperties": false
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "blob": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  },
                  "required": [
                    "path",
                    "blob"
                  ],
                  "additionalProperties": false
                }
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "review": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": [
                          "self",
                          "independent"
                        ]
                      },
                      "reviewer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "approved": {
                        "const": true
                      },
                      "unresolved": {
                        "const": 0
                      }
                    },
                    "required": [
                      "kind",
                      "reviewer",
                      "approved",
                      "unresolved"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "schema_version",
              "methodology_version",
              "task_id",
              "packet_digest",
              "phase",
              "head_sha",
              "inputs",
              "outputs",
              "summary",
              "review"
            ],
            "additionalProperties": false
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact",
          "recorded_at"
        ],
        "additionalProperties": false
      }
    },
    "completed_work": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pending_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "failure": {
      "enum": [
        null,
        "capability",
        "environment",
        "design",
        "authority"
      ]
    },
    "remaining_budget": {
      "type": "integer",
      "minimum": 0
    },
    "recovery_instructions": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "queued",
        "completed"
      ]
    },
    "verified_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "methodology_version": {
            "const": "1.0"
          },
          "source": {
            "const": "local-executor"
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "packet_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "plan_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "T0",
              "T1",
              "T2"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "expected": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "failure": {
            "type": [
              "string",
              "null"
            ]
          },
          "unchanged": {
            "type": "boolean"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "output_excerpt": {
            "type": "string"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "observed_at": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "methodology_version",
          "source",
          "task_id",
          "packet_digest",
          "plan_digest",
          "phase",
          "name",
          "role",
          "tier",
          "argv",
          "head_sha",
          "exit_code",
          "expected",
          "failure",
          "unchanged",
          "output_sha256",
          "output_bytes",
          "output_excerpt",
          "elapsed_seconds",
          "observed_at"
        ],
        "additionalProperties": false
      }
    },
    "failure_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "enum": [
              "capability",
              "environment",
              "design",
              "authority"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "number",
          "classification",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "checkpoint_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "methodology_version",
    "task_id",
    "packet_digest",
    "plan_digest",
    "repository",
    "base_sha",
    "head_sha",
    "phase",
    "artifacts",
    "completed_work",
    "pending_steps",
    "attempts",
    "failure",
    "remaining_budget",
    "recovery_instructions",
    "status",
    "verified_results",
    "failure_history",
    "checkpoint_digest"
  ],
  "additionalProperties": false
}
