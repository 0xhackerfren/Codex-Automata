{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-automata:1.0:artifact",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "methodology_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "enum": [
        "intake",
        "architect",
        "specify",
        "sdk",
        "mold",
        "cast",
        "review",
        "product",
        "observe"
      ]
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "path",
          "blob"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "path",
          "blob"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "self",
                "independent"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "approved": {
              "const": true
            },
            "unresolved": {
              "const": 0
            }
          },
          "required": [
            "kind",
            "reviewer",
            "approved",
            "unresolved"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "methodology_version",
    "task_id",
    "packet_digest",
    "phase",
    "head_sha",
    "inputs",
    "outputs",
    "summary",
    "review"
  ],
  "additionalProperties": false
}
