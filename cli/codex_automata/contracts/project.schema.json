{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-automata:1.0:project",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "methodology_version": {
      "const": "1.0"
    },
    "project_root": {
      "const": "."
    },
    "adoption_profile": {
      "enum": [
        "essential",
        "standard",
        "complete"
      ]
    },
    "paths": {
      "type": "object",
      "properties": {
        "source": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "specifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sdk": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "generated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "runtime_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "operational_entrypoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "agent_instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sensitive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "tests",
        "specifications",
        "sdk",
        "generated",
        "runtime_state",
        "operational_entrypoints",
        "agent_instructions",
        "sensitive",
        "allowed",
        "forbidden"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "DEVELOP": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "OPERATE": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "MAINTAIN_METHODOLOGY": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "DEVELOP",
        "OPERATE",
        "MAINTAIN_METHODOLOGY"
      ],
      "additionalProperties": false
    },
    "review_policy": {
      "enum": [
        "self-for-low-risk",
        "independent"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "argv"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "methodology_version",
    "project_root",
    "adoption_profile",
    "paths",
    "capabilities",
    "review_policy",
    "checks"
  ],
  "additionalProperties": false
}
